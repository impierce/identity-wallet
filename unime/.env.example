DEV_MODE_ENABLED=false
LOG_STATE_UPDATES_TO_CONSOLE=false
# Debug builds only: log full action, credential and protocol payloads (see docs/adr/0003-no-personal-data-in-logs.md)
LOG_FULL_PAYLOADS=false
# Debug builds only: allow requests over plain http, e.g. to a local issuer without a certificate (see docs/debugging.md)
# UNIME_ALLOW_PLAIN_HTTP=true
# Debug builds only: also trust the CA certificates in this PEM file, e.g. a local test CA (see docs/debugging.md)
# UNIME_EXTRA_CA_CERTS=/absolute/path/to/test-ca.pem
# Debug builds only: do not open the browser for an authorization, for automated tests (see docs/debugging.md)
# UNIME_NO_BROWSER=true
PUBLIC_DEV_MODE_MENU_EXPANDED=false
FEATURE_USER_JOURNEYS_ENABLED=false
PUBLIC_STYLE_SAFE_AREA_INSETS=false
PUBLIC_DEV_SHOW_CURRENT_ROUTE=false
