{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:menu:default",
    "core:path:default",
    "core:resources:default",
    "core:tray:default",
    "core:window:default",
    "cloud-storage:default",
    "cloud-storage:allow-check-permissions",
    "cloud-storage:allow-write-data",
    "cloud-storage:allow-delete",
    "fs:allow-appdata-read-recursive",
    "fs:allow-remove",
    "fs:allow-write-file",
    "keystore:default",
    "barcode-scanner:default",
    "log:default",
    "shell:allow-open",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/assets/**/*.png" }, { "path": "$APPDATA/assets/**/*.svg" }]
    }
  ]
}
