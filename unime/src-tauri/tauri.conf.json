{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "UniMe",
  "version": "0.13.3",
  "identifier": "com.impierce.identity-wallet",
  "app": {
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "style-src": "'unsafe-inline' 'self'",
        "img-src": "'self' asset: http://asset.localhost data:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/assets/**/*.png",
          "$APPDATA/assets/**/*.svg"
        ]
      }
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "UniMe - Identity Wallet",
        "width": 390,
        "height": 844
      }
    ]
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:4173",
    "frontendDist": "../build"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "Impierce Technologies B.V."
    },
    "linux": {
      "deb": {
        "desktopTemplate": "../UniMe.desktop"
      }
    },
    "resources": [
      "resources/*"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        { "scheme": [ "unime" ] },
        { "scheme": [ "openid" ] },
        { "scheme": [ "openid4vp" ] },
        { "scheme": [ "openid-credential-offer" ] }
      ],
      "desktop": {
        "schemes": ["unime", "openid", "openid4vp", "openid-credential-offer"]
      }
    }
  }
}
