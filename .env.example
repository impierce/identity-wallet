# Release upload settings for scripts/upload-mobile-releases.sh. Copy to .env (git-ignored) and fill in.
# Keep the key files outside the repository; relative paths resolve from the repository root.

# Google Play: JSON key of a service account with release permissions for the app in Play Console.
PLAY_SERVICE_ACCOUNT_JSON=""

# App Store Connect API key (Users and Access > Integrations): its ID, the issuer ID and the downloaded .p8 file.
ASC_KEY_ID=""
ASC_ISSUER_ID=""
ASC_KEY_P8_PATH=""

# Comma-separated names of the internal TestFlight groups that receive the build.
TESTFLIGHT_INTERNAL_GROUPS=""

# Export compliance answer ("true" or "false"), only needed while the iOS Info.plist does not declare
# ITSAppUsesNonExemptEncryption.
IOS_USES_NON_EXEMPT_ENCRYPTION=""
