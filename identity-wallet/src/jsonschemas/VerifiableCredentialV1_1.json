{
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "$id": "https://www.w3.org/TR/vc-data-model-1.1",
  "title": "Verifiable Credential",
  "description": "Schema for a Verifiable Credential (VC) following W3C VC Data Model 1.1",
  "type": "object",
  "required": ["@context", "type", "issuer", "issuanceDate", "credentialSubject"],
  "properties": {
    "@context": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": { "const": "https://www.w3.org/2018/credentials/v1" },
      "minItems": 1
    },
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Optional unique identifier for the credential"
    },
    "type": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "contains": {
            "const": "VerifiableCredential"
          }
        },
        {
          "type": "string",
          "const": "VerifiableCredential"
        }
      ]
    },
    "issuer": {
      "oneOf": [
        { "type": "string", "format": "uri" },
        {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "format": "uri" }
          },
          "additionalProperties": true
        }
      ],
      "description": "Issuer can be a URI or an object with an 'id'"
    },
    "credentialSubject": {
      "oneOf": [
        { "type": "object" },
        {
          "type": "array",
          "items": { "type": "object" }
        }
      ],
      "description": "Holds subject claims, additional properties allowed"
    },
    "issuanceDate": {
      "type": "string",
      "format": "date-time"
    },
    "expirationDate": {
      "type": "string",
      "format": "date-time"
    },
    "credentialStatus": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "type": { "type": "string" }
      }
    },
    "credentialSchema": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "type"],
          "properties": {
            "id": { "type": "string", "format": "uri" },
            "type": { "type": "string" }
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string", "format": "uri" },
              "type": { "type": "string" }
            }
          }
        }
      ]
    },
    "refreshService": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "type"],
          "properties": {
            "id": { "type": "string", "format": "uri" },
            "type": { "type": "string" }
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string", "format": "uri" },
              "type": { "type": "string" }
            }
          }
        }
      ]
    },
    "termsOfUse": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "id": { "type": "string", "format": "uri" },
            "type": { "type": "string" }
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "id": { "type": "string", "format": "uri" },
              "type": { "type": "string" }
            }
          }
        }
      ]
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "id": { "type": "string", "format": "uri" },
            "type": { "type": "string" }
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "id": { "type": "string", "format": "uri" },
              "type": { "type": "string" }
            }
          }
        }
      ]
    },
    "proof": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" }
      },
      "additionalProperties": true,
      "description": "Cryptographic proof of the credential"
    },
    "name": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": ["@value"],
          "properties": {
            "@value": { "type": "string" },
            "@lang": { "type": "string" },
            "@direction": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "description": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": ["@value"],
          "properties": {
            "@value": { "type": "string" },
            "@lang": { "type": "string" },
            "@direction": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": true
}
