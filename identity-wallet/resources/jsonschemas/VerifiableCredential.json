              },
              "additionalProperties": true
            }
          ],
          "description": "Issuer can be a url or an object with an 'id'"
        },
        "credentialSubject": {
          "oneOf": [
            { "type": "object" },
            {
              "type": "array",
              "items": { "type": "object" }
            }
