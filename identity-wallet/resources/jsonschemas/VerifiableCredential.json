          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string" }
          },
          "additionalProperties": true,
          "description": "Cryptographic proof of the credential"
        },
        "name": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": ["@value"],
              "properties": {
                "@value": { "type": "string" },
                "@lang": { "type": "string" },
                "@direction": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        },
        "description": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": ["@value"],
              "properties": {
                "@value": { "type": "string" },
                "@lang": { "type": "string" },
                "@direction": { "type": "string" }
              },
              "additionalProperties": false
