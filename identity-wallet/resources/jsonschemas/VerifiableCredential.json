        "credentialStatus": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "id": { "type": "string", "format": "url" },
            "type": { "type": "string" }
          }
        },
        "credentialSchema": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "id": { "type": "string", "format": "url" },
            "type": { "type": "string" }
          }
        },
        "refreshService": {
          "oneOf": [
            {
              "type": "object",
