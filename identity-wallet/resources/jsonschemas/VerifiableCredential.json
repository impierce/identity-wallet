        "termsOfUse": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type"],
              "properties": {
                "id": { "type": "string", "format": "url" },
                "type": { "type": "string" }
              }
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "id": { "type": "string", "format": "url" },
                  "type": { "type": "string" }
                }
              }
            }
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type"],
              "properties": {
                "id": { "type": "string", "format": "url" },
                "type": { "type": "string" }
              }
            },
            {
              "type": "array",
