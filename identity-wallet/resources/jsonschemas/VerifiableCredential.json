        "termsOfUse": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type"],
              "properties": {
                "id": { "type": "string", "format": "uri" },
                "type": { "type": "string" }
              }
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "id": { "type": "string", "format": "uri" },
                  "type": { "type": "string" }
                }
              }
            }
          ]
        },
        "evidence": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type"],
              "properties": {
                "id": { "type": "string", "format": "uri" },
                "type": { "type": "string" }
              }
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "id": { "type": "string", "format": "uri" },
                  "type": { "type": "string" }
                }
              }
            }
          ]
